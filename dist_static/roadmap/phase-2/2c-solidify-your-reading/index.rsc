2:[[["$","link","css:/my_learning_docs/_next/static/css/index.CVZ2Htb6.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/my_learning_docs/_next/static/css/index.CVZ2Htb6.css","data-rsc-css-href":"/my_learning_docs/_next/static/css/index.CVZ2Htb6.css"}],"$undefined"],["$","html",null,{"lang":"zh-CN","data-language-mode":"bilingual","data-theme":"paper","data-site-base-path":"/my_learning_docs","suppressHydrationWarning":true,"children":[["$","head",null,{"children":[["$","script",null,{"dangerouslySetInnerHTML":{"__html":"try{var m=localStorage.getItem('refold-language-mode');if(['en','zh','bilingual'].includes(m)){document.documentElement.dataset.languageMode=m}var t=localStorage.getItem('refold-theme');if(['paper','dark','solarized','green'].includes(t)){document.documentElement.dataset.theme=t}}catch(e){}"}}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"document.addEventListener('click',function(e){if(e.defaultPrevented||e.button!==0||e.metaKey||e.ctrlKey||e.shiftKey||e.altKey)return;var a=e.target.closest&&e.target.closest('a[href]');if(!a||a.hasAttribute('download')||(a.target&&a.target!=='_self'))return;var u=new URL(a.href,location.href),b=document.documentElement.dataset.siteBasePath||'';if(b&&u.origin===location.origin&&u.pathname!==b&&!u.pathname.startsWith(b+'/')&&(u.pathname==='/'||u.pathname.startsWith('/roadmap/'))){u.pathname=b+(u.pathname==='/'?'/':u.pathname)}if(u.origin!==location.origin||(u.protocol!=='http:'&&u.protocol!=='https:')||(u.pathname===location.pathname&&u.search===location.search&&u.hash))return;e.preventDefault();e.stopImmediatePropagation();location.assign(u.href)},true);"}}]]}],["$","body",null,{"children":["$","$L4",null,{}]}]]}]]
