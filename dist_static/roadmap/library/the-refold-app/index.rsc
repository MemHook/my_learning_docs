1:["$","$Ld",null,{"page":{"id":"library--the-refold-app","kind":"library-article","route":"/roadmap/library/the-refold-app","sourceUrl":"https://refold.la/roadmap/library/the-refold-app","sourceHash":"930fadc71a2bd0248deaa0816ae38c136be59a1a637c85114200fa7b5c27da95","collectedAt":"2026-09-01T23:11:14.302Z","bodyMode":"authorized-full-body","title":{"en":"The Refold App","zh":"Refold 应用"},"description":{"en":"","zh":""},"segments":[{"id":"segment-0001","type":"paragraph","content":{"en":"The Refold App is a tool designed to help you track your language learning activities, build consistent habits, and monitor your progress through the Refold roadmap.","zh":"Refold 应用是一款帮助你记录语言学习活动、养成稳定习惯，并在 Refold 路线图中跟踪学习进度的工具。"}},{"id":"segment-0002","type":"paragraph","content":{"en":"If you're reading this, you already have an account and are on the webapp! You can click the \"Dashboard\" button in the header to see your main tracking page.","zh":"既然你正在阅读这段内容，就说明你已经拥有账户并进入了网页应用！你可以点击页眉中的“仪表板”按钮，查看主要的学习记录页面。"}},{"id":"segment-0003","type":"paragraph","content":{"en":"You can also <a href=\"https://refold.link/app\" target=\"_blank\" rel=\"noopener noreferrer\">download the mobile app</a> if you'd like.","zh":"如果愿意，你也可以<a href=\"https://refold.link/app\" target=\"_blank\" rel=\"noopener noreferrer\">下载移动应用</a>。"}},{"id":"segment-0004","type":"paragraph","content":{"en":"<em>This video predates the webapp! But the main functions are the same. Hopefully, it's fairly intuitive.</em>","zh":"<em>这段视频早于网页应用！但主要功能是一样的。希望它的使用方式足够直观。</em>"}},{"id":"key-features","type":"heading","level":2,"content":{"en":"Key Features","zh":"主要功能"}},{"id":"segment-0006","type":"list","ordered":false,"items":[{"en":"<strong>Activity tracking:</strong> Log your daily learning time by activity type (priming, interactive, freeflow, output)","zh":"<strong>活动追踪：</strong>按活动类型（准备、互动、自由流、输出）记录每天的学习时间"},{"en":"<strong>Activity Library:</strong> If you don't know what to do or what to call your studying, the Library has dozens of in-depth tutorials","zh":"<strong>活动库：</strong>如果你不知道该做什么，或不知道如何称呼自己的学习活动，活动库中有数十份深入的教程"},{"en":"<strong>Habit Health:</strong> Track your consistency with a hit-rate model rather than streaks — see Habit Health for details","zh":"<strong>习惯健康度：</strong>使用命中率模型而不是连续打卡来追踪坚持情况——详情请参阅“习惯健康度”"},{"en":"<strong>Progress overview:</strong> See your cumulative hours and how they compare to the benchmarks for your current phase","zh":"<strong>进度概览：</strong>查看累计学习时长，以及它与当前阶段基准值的对比"}]},{"id":"tips","type":"heading","level":2,"content":{"en":"Tips","zh":"提示"}},{"id":"segment-0008","type":"list","ordered":false,"items":[{"en":"Use the stopwatch whenever possible for accurate tracking, but don't stress about perfect accuracy","zh":"尽可能使用秒表来准确追踪，但不必为完美的准确性焦虑"},{"en":"Track consistently for at least 2 weeks to see meaningful patterns","zh":"至少连续追踪 2 周，才能看到有意义的规律"},{"en":"Review your data weekly to check whether your time balance matches the recommendations for your phase","zh":"每周查看一次数据，确认你的时间分配是否符合当前阶段的建议"}]}],"cards":[]}}]
