3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"The Reading-Listening Gap / 阅读与听力差距 · Refold 双语路线图"}],["$","meta","1",{"name":"description","content":"Refold Roadmap 本地双语学习版本。"}],["$","meta","2",{"property":"og:title","content":"Refold 双语路线图"}],["$","meta","3",{"property":"og:description","content":"English × 中文 · 逐段对照阅读"}],["$","meta","4",{"property":"og:image","content":"http://localhost:3000/my_learning_docs/og.png"}],["$","meta","5",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","6",{"name":"twitter:title","content":"Refold 双语路线图"}],["$","meta","7",{"name":"twitter:description","content":"English × 中文 · 逐段对照阅读"}],["$","meta","8",{"name":"twitter:image","content":"http://localhost:3000/my_learning_docs/og.png"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["roadmap","library/the-reading-listening-gap"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"roadmap","fallback":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":404}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],"children":["$","$Lb",null,{"children":["$","$Lc",null,{"children":[["$","$L8",null,{"providerId":"page:/roadmap/library/the-reading-listening-gap","segmentMap":{"children":["__PAGE__"]},"children":["$","$L9",null,{"id":"page:/roadmap/library/the-reading-listening-gap"}]}],null]}]}]}]}]}]}]}],null,null]
