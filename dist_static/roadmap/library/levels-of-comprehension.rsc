2:[[["$","link","css:/_next/static/css/index.CVZ2Htb6.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/_next/static/css/index.CVZ2Htb6.css","data-rsc-css-href":"/_next/static/css/index.CVZ2Htb6.css"}],"$undefined"],["$","html",null,{"lang":"zh-CN","data-language-mode":"bilingual","data-theme":"paper","suppressHydrationWarning":true,"children":[["$","head",null,{"children":[["$","script",null,{"dangerouslySetInnerHTML":{"__html":"try{var m=localStorage.getItem('refold-language-mode');if(['en','zh','bilingual'].includes(m)){document.documentElement.dataset.languageMode=m}var t=localStorage.getItem('refold-theme');if(['paper','dark','solarized','green'].includes(t)){document.documentElement.dataset.theme=t}}catch(e){}"}}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"document.addEventListener('click',function(e){if(e.defaultPrevented||e.button!==0||e.metaKey||e.ctrlKey||e.shiftKey||e.altKey)return;var a=e.target.closest&&e.target.closest('a[href]');if(!a||a.hasAttribute('download')||(a.target&&a.target!=='_self'))return;var u=new URL(a.href,location.href);if(u.origin!==location.origin||u.protocol!=='http:'&&u.protocol!=='https:'||u.pathname===location.pathname&&u.search===location.search&&u.hash)return;e.preventDefault();e.stopImmediatePropagation();location.assign(u.href)},true);"}}]]}],["$","body",null,{"children":["$","$L4",null,{}]}]]}]]
3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Levels of Comprehension / 理解能力等级 · Refold 双语路线图"}],["$","meta","1",{"name":"description","content":"Refold Roadmap 本地双语学习版本。"}],["$","meta","2",{"property":"og:title","content":"Refold 双语路线图"}],["$","meta","3",{"property":"og:description","content":"English × 中文 · 逐段对照阅读"}],["$","meta","4",{"property":"og:image","content":"http://localhost:3000/og.png"}],["$","meta","5",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","6",{"name":"twitter:title","content":"Refold 双语路线图"}],["$","meta","7",{"name":"twitter:description","content":"English × 中文 · 逐段对照阅读"}],["$","meta","8",{"name":"twitter:image","content":"http://localhost:3000/og.png"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["roadmap","library/levels-of-comprehension"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"roadmap","fallback":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":404}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],"children":["$","$Lb",null,{"children":["$","$Lc",null,{"children":[["$","$L8",null,{"providerId":"page:/roadmap/library/levels-of-comprehension","segmentMap":{"children":["__PAGE__"]},"children":["$","$L9",null,{"id":"page:/roadmap/library/levels-of-comprehension"}]}],null]}]}]}]}]}]}]}],null,null]
