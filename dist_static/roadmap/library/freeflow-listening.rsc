1:["$","$Ld",null,{"page":{"id":"library--freeflow-listening","kind":"library-article","route":"/roadmap/library/freeflow-listening","sourceUrl":"https://refold.la/roadmap/library/freeflow-listening","sourceHash":"a9a0a255b330609f195fde4a75a44e575613883b1daf3c913e1d3b2ba1ca1dea","collectedAt":"2026-09-01T16:52:58.830Z","bodyMode":"authorized-full-body","title":{"en":"Freeflow Listening","zh":"自由流听力"},"description":{"en":"","zh":""},"segments":[{"id":"segment-0001","type":"paragraph","content":{"en":"Freeflow listening is listening to target-language audio without any text support, tools, or pausing. You just listen and try to understand as much as you can naturally.","zh":"自由流听力是指在没有任何文字辅助、不借助工具、也不暂停的情况下聆听目标语言音频。你只需继续听，并自然地尽可能多理解内容。"}},{"id":"segment-0002","type":"paragraph","content":{"en":"<a href=\"https://refold.la/learning-libraries?item=30104-freeflow-listening&amp;type=activity\">-&gt; See recommended Freeflow listening tools and more info</a>","zh":"<a href=\"https://refold.la/learning-libraries?item=30104-freeflow-listening&amp;type=activity\">-&gt; 查看推荐的自由流听力工具及更多信息</a>"}},{"id":"how-it-differs-from-intensive-listening","type":"heading","level":2,"content":{"en":"How It Differs from Intensive Listening","zh":"它与精听有何不同"}},{"id":"segment-0004","type":"paragraph","content":{"en":"In intensive listening, you pause, relisten, and check subtitles. In freeflow listening, you let the audio play continuously and accept whatever you understand. Intensive builds understanding; freeflow builds speed and automaticity.","zh":"精听时，你会暂停、反复听并查看字幕。进行自由流听力时，你会让音频连续播放，能理解多少就接受多少。精听提升理解能力；自由流听力则培养速度和自动化处理能力。"}},{"id":"what-counts","type":"heading","level":2,"content":{"en":"What Counts","zh":"哪些活动算自由流听力"}},{"id":"segment-0006","type":"list","ordered":false,"items":[{"en":"Watching TV or movies without subtitles","zh":"不看字幕观看电视节目或电影"},{"en":"Listening to podcasts","zh":"收听播客"},{"en":"Listening to audiobooks","zh":"收听有声书"},{"en":"Watching YouTube videos without subtitles","zh":"不看字幕观看 YouTube 视频"},{"en":"Overhearing conversations (if you live in a TL-speaking area)","zh":"听周围人的对话（如果你住在使用目标语言的地区）"},{"en":"Crosstalk is also technically a form of freeflow listening!","zh":"严格来说，跨语言交流也属于自由流听力的一种！"}]},{"id":"tips","type":"heading","level":2,"content":{"en":"Tips","zh":"建议"}},{"id":"segment-0008","type":"list","ordered":false,"items":[{"en":"Your comprehension will be lower than with text support. That's the point — you're training your brain to work without the crutch.","zh":"你的理解能力表现会低于有文字辅助时。这正是训练的目的——你是在训练大脑摆脱这种依赖，自主处理语言。"},{"en":"Start with familiar content (things you've already watched with subtitles) so your prior knowledge fills in gaps.","zh":"从熟悉的内容开始（例如你已经看过字幕的内容），这样已有知识就能帮你补足没听懂的部分。"},{"en":"As your level improves, shift to unfamiliar content.","zh":"随着水平提高，逐渐转向陌生内容。"},{"en":"If you understand almost nothing, the content is too hard for freeflow. Use easier material or do more intensive listening first.","zh":"如果你几乎什么都听不懂，这份内容对自由流听力来说就太难了。请使用更简单的材料，或先进行更多精听。"},{"en":"Background listening (audio on while you do something else) has limited value. Try to stay at least half focused.","zh":"背景听力（做其他事情时播放音频）的价值有限。请尽量至少保持一半的注意力。"}]},{"id":"segment-0009","type":"paragraph","content":{"en":"<a href=\"https://refold.la/learning-libraries?item=30105-half-attention-listening&amp;type=activity\">-&gt; More about Half-attention Listening</a>","zh":"<a href=\"https://refold.la/learning-libraries?item=30105-half-attention-listening&amp;type=activity\">-&gt; 进一步了解半专注听力</a>"}},{"id":"when-to-start","type":"heading","level":2,"content":{"en":"When to Start","zh":"何时开始"}},{"id":"segment-0011","type":"paragraph","content":{"en":"Freeflow listening is introduced in Phase 3A and grows throughout Phases 3-7. By Phase 6-7, the majority of your listening should be freeflow.","zh":"自由流听力会在第 3A 阶段引入，并在第 3 至第 7 阶段持续增加。到第 6 至第 7 阶段时，你的大部分听力活动都应该是自由流听力。"}}],"cards":[]}}]
