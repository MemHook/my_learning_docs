1:["$","$Ld",null,{"page":{"id":"library--automatic-subtitle-generation","kind":"library-article","route":"/roadmap/library/automatic-subtitle-generation","sourceUrl":"https://refold.la/roadmap/library/automatic-subtitle-generation","sourceHash":"e636184242923c42a7505d14d7f804b272b4ddbe86a9e5f25f679298626315c4","collectedAt":"2026-09-01T16:52:29.953Z","bodyMode":"authorized-full-body","title":{"en":"Automatic Subtitle Generation","zh":"自动生成字幕"},"description":{"en":"","zh":""},"segments":[{"id":"segment-0001","type":"paragraph","content":{"en":"<em>This page is a stub. I need to finish it.</em>","zh":"<em>本页面目前只是一个框架，我还需要把它写完。</em>"}},{"id":"segment-0002","type":"paragraph","content":{"en":"But for now, I'll link to my old Whisper video:","zh":"不过现在先放上我以前制作的 Whisper 视频链接："}},{"id":"segment-0003","type":"paragraph","content":{"en":"But the main idea is to find some sort of pipeline to get audio, then use an AI tool to transcribe it. Whisper works, but requires a GPU. Setting up Kaggle is free, but a hassle and hard for non techies.","zh":"核心思路是找到某种获取音频的流程，然后使用 AI 工具进行转录。Whisper 可以做到，但需要 GPU。Kaggle 可以免费使用，但设置起来很麻烦，对非技术人员也不友好。"}}],"cards":[]},"siteBasePath":"/my_learning_docs"}]
