1:["$","$Ld",null,{"page":{"id":"library--proficiency-testing","kind":"library-article","route":"/roadmap/library/proficiency-testing","sourceUrl":"https://refold.la/roadmap/library/proficiency-testing","sourceHash":"b4304a41680941ade7be0fd9d23bc45553f6be4378b6e5fb14e496e6a156c2d6","collectedAt":"2026-09-01T23:10:58.723Z","bodyMode":"authorized-full-body","title":{"en":"Proficiency Testing","zh":"语言水平测试"},"description":{"en":"","zh":""},"segments":[{"id":"segment-0001","type":"paragraph","content":{"en":"Proficiency tests are standardized exams that certify your language ability at a specific level. Common tests include CEFR-based exams (DELE for Spanish, DELF/DALF for French, Goethe-Zertifikat for German, etc.), JLPT for Japanese, HSK for Chinese, and TOPIK for Korean.","zh":"语言水平测试是用于认证你的语言能力达到特定级别的标准化考试。常见考试包括以 CEFR 为标准的考试（西班牙语 DELE、法语 DELF/DALF、德语 Goethe-Zertifikat 等）、日语 JLPT、汉语 HSK，以及韩语 TOPIK。"}},{"id":"do-you-need-one","type":"heading","level":2,"content":{"en":"Do You Need One?","zh":"你需要参加吗？"}},{"id":"segment-0003","type":"paragraph","content":{"en":"Only if you have a specific reason: university admission, work requirements, immigration, or personal goals. The Refold roadmap provides more actionable guidance for improvement than a test level ever could.","zh":"只有在你有明确理由时才需要，例如大学入学、工作要求、移民或个人目标。与任何考试等级相比，Refold 路线图都能为提升语言能力提供更具可操作性的指导。"}},{"id":"the-refold-advantage","type":"heading","level":2,"content":{"en":"The Refold Advantage","zh":"Refold 的优势"}},{"id":"segment-0005","type":"paragraph","content":{"en":"If you've followed the Refold method, you have much stronger listening and reading comprehension than most test-takers at your level. Your main challenges will be test-specific: unfamiliar question formats, timed writing under constraints, and grammar points that are tested but rarely appear in natural immersion.","zh":"如果你一直遵循 Refold 方法，那么你的听力和阅读理解能力会远强于同等级的大多数考生。你面临的主要挑战将与考试本身有关：不熟悉的题型、限时且受条件约束的写作，以及考试会考、却很少出现在自然沉浸中的语法点。"}},{"id":"preparation-strategy","type":"heading","level":2,"content":{"en":"Preparation Strategy","zh":"备考策略"}},{"id":"segment-0007","type":"paragraph","content":{"en":"See the full article for specific information and advice: <a href=\"/roadmap/phase-x/xx-optional-proficiency-testing\">XX (Optional) — Proficiency Testing</a>","zh":"具体信息和建议请参阅完整文章：<a href=\"/roadmap/phase-x/xx-optional-proficiency-testing\">XX（可选）——语言水平测试</a>"}}],"cards":[]}}]
