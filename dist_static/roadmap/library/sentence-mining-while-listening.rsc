1:["$","$Ld",null,{"page":{"id":"library--sentence-mining-while-listening","kind":"library-article","route":"/roadmap/library/sentence-mining-while-listening","sourceUrl":"https://refold.la/roadmap/library/sentence-mining-while-listening","sourceHash":"c5af329e4e05c08c9e9585e1a22955fdd1dbd9be105389d8c8daf610e8225759","collectedAt":"2026-09-01T23:11:02.798Z","bodyMode":"authorized-full-body","title":{"en":"Sentence Mining (While Listening)","zh":"句子挖掘（边听边挖掘）"},"description":{"en":"","zh":""},"segments":[{"id":"segment-0001","type":"paragraph","content":{"en":"Sentence Mining while Listening is the same concept as regular sentence mining, but with a twist: you try to understand through audio first, only revealing subtitles when you're stuck.","zh":"边听边做句子挖掘与普通句子挖掘的概念相同，但有一点变化：你要先尝试通过音频理解，只有遇到困难时才显示字幕。"}},{"id":"segment-0002","type":"paragraph","content":{"en":"<a href=\"/roadmap/library/sentence-mining\">Sentence Mining</a>","zh":"<a href=\"/roadmap/library/sentence-mining\">句子挖掘</a>"}},{"id":"how-it-works","type":"heading","level":2,"content":{"en":"How It Works","zh":"具体做法"}},{"id":"segment-0004","type":"list","ordered":true,"items":[{"en":"Watch content with subtitles <em>hidden</em> (but loaded and ready to reveal)","zh":"观看内容时将字幕设为<em>隐藏</em>（但要提前加载好，以便随时显示）"},{"en":"Listen to each line and try to understand","zh":"听每一句台词，并尝试理解"},{"en":"When you hear something interesting or can't understand, replay it a few times","zh":"听到有趣的内容或无法理解时，重放几遍"},{"en":"If you still can't understand, reveal the subtitles and check","zh":"如果仍然无法理解，就显示字幕进行核对"},{"en":"Look up unknown words","zh":"查询未知词"},{"en":"If the sentence has only 1-2 unknown words, save it as a flashcard","zh":"如果句子中只有 1～2 个未知词，就将它保存为闪卡"},{"en":"Rewatch the section to hear it at natural speed","zh":"重新观看这一片段，听清它在自然语速下的发音"},{"en":"Hide subtitles again and continue","zh":"再次隐藏字幕，然后继续"}]},{"id":"segment-0005","type":"paragraph","content":{"en":"<a href=\"https://refold.la/learning-libraries?item=30102-sentence-mining-while-listening&amp;type=activity\">-&gt; Full Sentence Mining (While Listening) Tutorial</a>","zh":"<a href=\"https://refold.la/learning-libraries?item=30102-sentence-mining-while-listening&amp;type=activity\">-&gt; 完整的句子挖掘（边听边挖掘）教程</a>"}},{"id":"how-it-differs-from-regular-sentence-mining","type":"heading","level":2,"content":{"en":"How It Differs from Regular Sentence Mining","zh":"与普通句子挖掘有何不同"}},{"id":"segment-0007","type":"paragraph","content":{"en":"Regular sentence mining (Phase 2) uses subtitles as the primary channel — you read along and mine words you see. Sentence Mining while Listening flips this: audio is primary, text is the fallback.","zh":"普通句子挖掘（阶段 2）以字幕为主要渠道——你一边阅读字幕，一边挖掘看到的单词。边听边做句子挖掘则反过来：音频是主要渠道，文字只在需要时作为辅助。"}},{"id":"segment-0008","type":"paragraph","content":{"en":"This trains your ear while still building vocabulary.","zh":"这样既能训练听力，又能继续积累词汇。"}},{"id":"tips","type":"heading","level":2,"content":{"en":"Tips","zh":"建议"}},{"id":"segment-0010","type":"list","ordered":false,"items":[{"en":"This is harder and slower than text-based mining. That's the point.","zh":"这比基于文字的句子挖掘更难、速度也更慢——这正是它的意义所在。"},{"en":"Use the same tools and setup as regular sentence mining, just keep subtitles hidden by default","zh":"使用与普通句子挖掘相同的工具和配置，只需默认隐藏字幕"},{"en":"Auto-pause features are helpful for giving you time to process each line","zh":"自动暂停功能很有帮助，可以让你有时间处理每一句台词"},{"en":"As your listening improves, you'll need to reveal subtitles less and less","zh":"随着听力提高，你需要显示字幕的次数会越来越少"}]},{"id":"when-to-start","type":"heading","level":2,"content":{"en":"When to Start","zh":"何时开始"}},{"id":"segment-0012","type":"paragraph","content":{"en":"Sentence Mining while Listening is introduced in Phase 3A and continues through Phase 7.","zh":"边听边做句子挖掘会在阶段 3A 引入，并持续到阶段 7。"}}],"cards":[]},"siteBasePath":"/my_learning_docs"}]
